{
  "manifest_version": 3,
  "name": "Confluence Markdown",
  "version": "1.2.0",
  "description": "Confluence 본문을 LLM 컨텍스트용 Markdown으로 다운로드합니다.",
  "permissions": ["activeTab", "alarms"],
  "host_permissions": ["https://raw.githubusercontent.com/*"],
  "action": {
    "default_title": "Markdown으로 다운로드",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://confluence.score/*"],
      "js": [
        "lib/turndown.js",
        "lib/turndown-plugin-gfm.js",
        "lib/converter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
